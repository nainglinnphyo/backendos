# Postgres connection for the shared BackendOS instance (control-plane metadata + all project schemas)
DATABASE_URL=postgres://backendos:backendos@localhost:54329/backendos

# HTTP port the API server listens on
PORT=8787

# Base URL used to construct each project's "Project URL". In production this would be
# the host behind your wildcard DNS / reverse proxy; for local dev it's just this server.
PUBLIC_API_BASE_URL=http://localhost:8787
